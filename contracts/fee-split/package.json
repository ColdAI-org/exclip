{
  "name": "@exclip/fee-split-contracts",
  "private": true,
  "description": "The fee-split contracts' Foundry commands, runnable as pnpm scripts from contracts/fee-split. Not a workspace package.",
  "license": "Apache-2.0",
  "scripts": {
    "forge:build": "forge build",
    "forge:test": "forge test",
    "forge:coverage": "forge coverage --report summary --no-match-coverage '(test|script)/'",
    "forge:fmt": "forge fmt",
    "forge:fmt:check": "forge fmt --check",
    "forge:snapshot": "forge snapshot",
    "forge:inspect": "forge inspect",
    "slither": "slither .",
    "anvil": "anvil --silent --hardfork paris",
    "dry-run": "forge script script/Deploy.s.sol:Deploy --rpc-url http://127.0.0.1:8545",
    "dry-run:example": "PLATFORM_RECEIVER=0x1111111111111111111111111111111111111111 SAMPLE_OPERATOR=0x2222222222222222222222222222222222222222 pnpm run dry-run",
    "vectors": "forge script script/Vectors.s.sol:Vectors --rpc-url http://127.0.0.1:8545"
  }
}
