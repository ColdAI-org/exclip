{
  "name": "exclip",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "start": "pnpm --filter @exclip/server run start",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present run test"
  },
  "devDependencies": {
    "@exclip/config": "workspace:*",
    "@eslint/js": "^10.0.0",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.46.0"
  }
}
